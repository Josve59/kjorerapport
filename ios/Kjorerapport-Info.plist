<?xml version="1.0" encoding="UTF-8"?>
<!-- Det Xcode ikke lager selv: tillatelsestekster (appstore/README.md, del 3), opptak med låst skjerm og lokal server. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kjørerapport bruker posisjonen under kjøreturen for å måle fart og rute og vise fartsgrensen. Turen lagres bare på telefonen. For å hente fartsgrenser og kart sendes omtrentlig område til Statens vegvesen og Kartverket, uten navn.</string>
	<key>NSMotionUsageDescription</key>
	<string>Bevegelsessensorene måler bremsing, akselerasjon og svinger under kjøreturen. Målingene lagres bare på telefonen.</string>
	<key>NSCameraUsageDescription</key>
	<string>Kameraet er valgfritt. Frontkameraet ser om føreren sjekker speil og skulder, og bakkameraet ser veien foran. Bildene analyseres på telefonen og lagres eller sendes aldri.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 0.18.1: «Åpne i Kjørerapport» for meldinger fra læreren eller eleven, eksporterte turer og sikkerhetskopier (.json).
	     Alternate: appen er ikke hovedappen for JSON, bare et valg i delearket. Filen kopieres inn (ikke åpnet på stedet). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Kjørerapport-fil</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
